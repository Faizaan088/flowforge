# FlowForge environment template
# Copy to .env and replace all placeholder secrets.
ENVIRONMENT=development

# Authentication and security
FLOWFORGE_SECRET_KEY=replace-with-a-random-secret-generated-for-your-environment
FLOWFORGE_TOKEN_EXPIRE_MINUTES=60

# Initial admin account
FLOWFORGE_ADMIN_USERNAME=admin
FLOWFORGE_ADMIN_PASSWORD=replace-with-a-strong-unique-password

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://flowforge_user:replace-with-a-unique-url-safe-password-at-least-24-characters@localhost:5432/flowforge
POSTGRES_USER=flowforge_user
POSTGRES_PASSWORD=replace-with-a-unique-url-safe-password-at-least-24-characters
POSTGRES_DB=flowforge
DB_ECHO=false

# Local Docker port bindings
POSTGRES_BIND_IP=127.0.0.1
POSTGRES_PORT=5432
REDIS_BIND_IP=127.0.0.1
REDIS_PORT=6379
API_BIND_IP=127.0.0.1
API_PORT=8000
FRONTEND_BIND_IP=127.0.0.1
FRONTEND_PORT=3000
PROD_HTTP_PORT=80

# Redis — unauthenticated for local development only
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=
REQUIRE_REDIS_AUTH=false

# CORS — comma-separated allowed origins
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8000,http://127.0.0.1:5173,http://127.0.0.1:3000,http://127.0.0.1:8000

# Background maintenance intervals (seconds)
SCHEDULER_INTERVAL_SECONDS=5.0
EXECUTION_RECOVERY_INTERVAL_SECONDS=10.0
EXECUTION_RETRY_BASE_DELAY_SECONDS=10.0
RATE_LIMIT_CLEANUP_INTERVAL_SECONDS=60.0
RATE_LIMIT_RETENTION_BUFFER_SECONDS=3600.0
LOGIN_RATE_LIMIT_ATTEMPTS=10
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900

# Worker leases and heartbeats
LEASE_DURATION_SECONDS=30
HEARTBEAT_INTERVAL_SECONDS=10.0
LEASE_RENEW_INTERVAL_SECONDS=10.0
# WORKER_ID=worker-node-1

# Database schema is managed by migrations
AUTO_CREATE_TABLES=false

# Frontend — local Vite development only.
# Docker frontend build uses /api via the same-origin proxy.
VITE_API_URL=http://localhost:8000