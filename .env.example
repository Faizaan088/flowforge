# ==============================================================================
# FlowForge Production Environment Configuration Template
# Copy this file to .env and replace placeholders with secure production values.
# DO NOT COMMIT ACTUAL SECRETS TO VERSION CONTROL.
# ==============================================================================

# Application Environment ('production' | 'development' | 'testing')
ENVIRONMENT=production

# Security & Authentication (Required in production)
# FLOWFORGE_SECRET_KEY must be a cryptographically secure random string of at least 32 characters.
# Generate with: openssl rand -hex 32
FLOWFORGE_SECRET_KEY=replace-with-a-cryptographically-secure-random-secret-key-32-chars-min
FLOWFORGE_TOKEN_EXPIRE_MINUTES=60

# Initial Admin Bootstrap Account
FLOWFORGE_ADMIN_USERNAME=admin
FLOWFORGE_ADMIN_PASSWORD=replace-with-a-strong-admin-password-min-8-chars

# Database Configuration (PostgreSQL with asyncpg driver)
DATABASE_URL=postgresql+asyncpg://flowforge_user:replace_with_strong_db_password@postgres:5432/flowforge
POSTGRES_USER=flowforge_user
POSTGRES_PASSWORD=replace_with_strong_db_password
POSTGRES_DB=flowforge
DB_ECHO=false

# Redis Coordination & Pub/Sub
REDIS_URL=redis://redis:6379/0

# Cross-Origin Resource Sharing (CORS)
# Comma-separated list of trusted origin domains. Wildcard '*' is prohibited in production.
CORS_ALLOWED_ORIGINS=https://dashboard.flowforge.example.com,https://app.flowforge.example.com

# Engine & Background Maintenance Intervals
EXECUTION_RECOVERY_INTERVAL_SECONDS=10
RATE_LIMIT_CLEANUP_INTERVAL_SECONDS=60
RATE_LIMIT_RETENTION_BUFFER_SECONDS=3600

# Database Auto-Creation (Must be false in production; migrations run via Alembic)
AUTO_CREATE_TABLES=false
