# ==============================================================================
# FlowForge Production Environment Configuration Template (.env.production.example)
#
# INSTRUCTIONS:
# 1. Copy this file to '.env' on your production server.
# 2. Replace all placeholder values with unique, cryptographically strong secrets.
# 3. NEVER commit the resulting '.env' file to Git or share it publicly.
# ==============================================================================

# Application Environment Mode (MUST be set to 'production' for validation rules)
ENVIRONMENT=production

# ------------------------------------------------------------------------------
# 1. Core Authentication & Cryptographic Keys
# ------------------------------------------------------------------------------
# Generate with: openssl rand -hex 32 (MUST be at least 32 characters)
FLOWFORGE_SECRET_KEY=replace-with-a-random-hex-string-at-least-32-chars

# Token lifetime in minutes
FLOWFORGE_TOKEN_EXPIRE_MINUTES=60

# Initial Bootstrap Administrator (created only on the first boot)
FLOWFORGE_ADMIN_USERNAME=flowforge_admin
# Admin password MUST be 12-128 characters, unique, and differ from the username
FLOWFORGE_ADMIN_PASSWORD=replace-with-strong-admin-password-12-to-128-chars

# ------------------------------------------------------------------------------
# 2. Database Configuration (PostgreSQL 15+)
# ------------------------------------------------------------------------------
POSTGRES_USER=flowforge_user
# Password MUST be at least 24 URL-safe characters (letters, numbers, '-', '_')
POSTGRES_PASSWORD=replace-with-url-safe-password-at-least-24-characters-alphanumeric-dash-underscore
POSTGRES_DB=flowforge

# Compose internal database URL (used by API and Worker when running in Compose)
# For external PostgreSQL (e.g. Neon, Supabase, AWS RDS), set full URL here:
# DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/dbname
DB_ECHO=false

# ------------------------------------------------------------------------------
# 3. Redis Configuration (Redis 7+)
# ------------------------------------------------------------------------------
# Password MUST be at least 32 URL-safe characters (letters, numbers, '-', '_')
REDIS_PASSWORD=replace-with-url-safe-password-at-least-32-characters-alphanumeric-dash-underscore
REQUIRE_REDIS_AUTH=true

# For external Redis (e.g. Upstash, Redis Cloud), set full URL here:
# REDIS_URL=redis://:password@host:port/0

# ------------------------------------------------------------------------------
# 4. CORS Origins (Required in Production)
# ------------------------------------------------------------------------------
# Comma-separated list of EXACT HTTPS origins where your frontend is hosted.
# Wildcards ('*') and insecure HTTP origins are strictly rejected.
# Example: https://flowforge.vercel.app,https://app.yourdomain.com
CORS_ALLOWED_ORIGINS=https://flowforge.vercel.app

# ------------------------------------------------------------------------------
# 5. Production Host Port Bindings (Only for Docker Compose)
# ------------------------------------------------------------------------------
# HTTP port published on the host by frontend / reverse proxy (default: 80)
PROD_HTTP_PORT=80

# ------------------------------------------------------------------------------
# 6. Operational Tunings & Rate Limiting
# ------------------------------------------------------------------------------
AUTO_CREATE_TABLES=false
SCHEDULER_INTERVAL_SECONDS=5.0
EXECUTION_RECOVERY_INTERVAL_SECONDS=10.0
EXECUTION_RETRY_BASE_DELAY_SECONDS=10.0
RATE_LIMIT_CLEANUP_INTERVAL_SECONDS=60.0
RATE_LIMIT_RETENTION_BUFFER_SECONDS=3600.0
LOGIN_RATE_LIMIT_ATTEMPTS=10
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900

# ------------------------------------------------------------------------------
# 7. Worker Lease & Heartbeat Settings
# ------------------------------------------------------------------------------
LEASE_DURATION_SECONDS=30
HEARTBEAT_INTERVAL_SECONDS=10.0
LEASE_RENEW_INTERVAL_SECONDS=10.0

# ------------------------------------------------------------------------------
# 8. SMTP Email Delivery Configuration
# ------------------------------------------------------------------------------
# Set REQUIRE_SMTP=true to enforce strict production startup validation for SMTP.
REQUIRE_SMTP=false
# Configurable SMTP provider (e.g., SendGrid, AWS SES, Resend, Mailgun, Postmark):
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=flowforge-mailer
SMTP_PASSWORD=replace-with-your-strong-smtp-password
SMTP_FROM=FlowForge System <notifications@flowforge.dev>
SMTP_TLS=true
# Base URL of your deployed frontend (used in password reset and onboarding invitation links):
FRONTEND_BASE_URL=https://flowforge-098.vercel.app
